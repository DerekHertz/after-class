---
title: "After Class review record"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks R16_CitedEvidenceNeverExpires
    lg1: Breaks R14_DisputedNeverCountedAsGap or R16_CitedEvidenceNeverExpires in some cases
    lg2: Path to the R14_DisputedNeverCountedAsGap or R16_CitedEvidenceNeverExpires bug
  }
  class lg0 breaks
  class lg1 mayBreak
  class lg2 bugPath
  state "At the same time" as all {
    state "Review" as r0 {
      s0: Reviewing
      s1: Review ended
      s2: Question open
      [*] --> s0
      s0 --> s1: you end the review and the save fails
      s0 --> s2: the tutor asks about a claim
      s2 --> s0: you answer
    }
    --
    state "Note" as r1 {
      s3: No note yet
      s4: Save pending
      s5: Note saved
      [*] --> s3
      s3 --> s4: you end the review and the save fails [when Review is Reviewing]
      s4 --> s5: you retry the save [when Evidence is Evidence expired]
    }
    --
    state "Evidence" as r2 {
      s6: Evidence kept
      s7: Evidence expired
      [*] --> s6
      s6 --> s7: the evidence expires [when Review is Review ended and Note is Save pending]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 mayBreak
  class s1 bugPath
  class s2 bugPath
  class s3 bugPath
  class s4 mayBreak
  class s4 bugPath
  class s5 breaks
  class s5 bugPath
  class s6 mayBreak
  class s6 bugPath
  class s7 bugPath
