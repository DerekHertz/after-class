[Unit]
Description=Caddy reverse proxy for After Class
After=docker.service network-online.target afterclass-app.service
Wants=network-online.target
Requires=docker.service
# Certificates and the ACME account live on the data volume, so a replaced instance keeps them.
RequiresMountsFor=/data
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
ExecStartPre=-/usr/bin/docker rm -f afterclass-caddy
ExecStartPre=/usr/bin/mkdir -p /data/caddy/data /data/caddy/config
# Caddy joins the app's bridge network and publishes 80 and 443, instead of using host networking. A host-networked
# container reaches the instance metadata service, where the instance role's credentials are. A bridge-networked one
# cannot, because the metadata hop limit is 1. The container keeps only the capability to bind ports below 1024.
ExecStart=/usr/bin/docker run --rm --name afterclass-caddy --network afterclass -p 80:80 -p 443:443 \
  --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges --read-only --tmpfs /tmp \
  --log-driver awslogs --log-opt awslogs-region=${AWS_REGION} --log-opt awslogs-group=${LOG_GROUP} \
  --log-opt awslogs-stream=caddy --log-opt mode=non-blocking \
  -v /etc/afterclass/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /data/caddy/data:/data -v /data/caddy/config:/config \
  ${CADDY_IMAGE}
ExecStop=/usr/bin/docker stop -t 20 afterclass-caddy
EnvironmentFile=/etc/afterclass/settings.env

[Install]
WantedBy=multi-user.target
