---
title: "Finishing and saving a review (code, not flow)"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks FinishIsNeverSilentlyDropped
    lg1: Path to the FinishIsNeverSilentlyDropped bug
  }
  class lg0 breaks
  class lg1 bugPath
  state "At the same time" as all {
    state "Finish" as r0 {
      s0: Reviewing
      s1: Reviewing, last reply settling
      s2: Finish confirmed, nothing happened
      s3: Finishing
      s4: Finish failed, not delivered
      s5: Finish failed after delivery
      s6: Finish not delivered
      s7: Review ended
      s8: Finish delivered, no wrap-up
      [*] --> s0
      [*] --> s1
      s0 --> s3: you confirm Finish [when Screen is Review screen]
      s1 --> s0: the last reply settles
      s1 --> s2: you confirm Finish and nothing happens
      s3 --> s4: the request fails
      s3 --> s7: the tutor wraps up
      s3 --> s5: the tutor's wrap-up fails
      s4 --> s3: you press Retry
      s4 --> s6: you go home
      s5 --> s3: you press Finish again or you press Retry
      s5 --> s8: you go home
      s6 --> s3: you press Retry [when Screen is Review screen]
      s8 --> s3: you press Finish again or you press Retry [when Screen is Review screen]
    }
    --
    state "Save" as r1 {
      s9: Not saved
      s10: Saving
      s11: Saved
      s12: Save failed, failure cached
      s13: Saving, failure cached
      [*] --> s9
      s9 --> s10: the tutor wraps up [when Finish is one of Finish confirmed, nothing happened, Finishing and Screen is Review screen]
      s10 --> s11: the save succeeds
      s10 --> s12: the save fails
      s12 --> s13: you press Retry save [when Screen is Review screen]
      s13 --> s12: the save returns the cached failure
      s13 --> s11: the save succeeds
    }
    --
    state "Screen" as r2 {
      s14: Review screen
      s15: Home
      [*] --> s14
      s14 --> s15: you go home [when Finish is none of Finishing, Reviewing, last reply settling and Save is none of Saving, Saving, failure cached]
      s15 --> s14: you open the review from home [when Save is not Saved]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s1 bugPath
  class s2 breaks
  class s2 bugPath
  class s9 bugPath
  class s14 bugPath
