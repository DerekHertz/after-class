---
title: "After Class preparation and review"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks R3_JudgedOnlyAgainstCheckedClaims
    lg1: Breaks R3_JudgedOnlyAgainstCheckedClaims or R4_AtMostOneRevision in some cases
    lg2: Path to the R3_JudgedOnlyAgainstCheckedClaims or R4_AtMostOneRevision or R7_ScopeNeverGrows or R8_LateResultsNeverOverwrite bug
  }
  class lg0 breaks
  class lg1 mayBreak
  class lg2 bugPath
  state "At the same time" as all {
    state "Capture" as r0 {
      s0: Not capturing
      s1: Capturing
      [*] --> s0
      s0 --> s1: you start capture
    }
    --
    state "Preparation" as r1 {
      s2: Nothing closed yet
      s3: Preparing
      s4: Prepared
      [*] --> s2
      s2 --> s3: a chunk closes at a topic boundary [when Capture is Capturing]
      s3 --> s4: Jev says a claim is supported or an outdated result lands on a claim [when Review is No review]
      s4 --> s3: a later window moves a boundary [when Review is Reviewing]
    }
    --
    state "Review" as r2 {
      s5: No review
      s6: Reviewing
      s7: Question open
      [*] --> s5
      s5 --> s6: you press Review now [when Capture is Capturing and Preparation is Prepared]
      s6 --> s7: the tutor asks about a claim [when Preparation is Preparing]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 mayBreak
  class s1 bugPath
  class s2 bugPath
  class s3 mayBreak
  class s3 bugPath
  class s4 bugPath
  class s5 mayBreak
  class s5 bugPath
  class s6 bugPath
  class s7 breaks
  class s7 bugPath
