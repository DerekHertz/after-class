---
title: "After Class review record"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks R14_DisputedNeverCountedAsGap
    lg1: Path to the R14_DisputedNeverCountedAsGap bug
  }
  class lg0 breaks
  class lg1 bugPath
  state "At the same time" as all {
    state "Review" as r0 {
      s0: Reviewing
      s1: Question open
      s2: Review ended
      [*] --> s0
      s0 --> s1: the tutor asks about a claim
      s1 --> s0: you answer
      s0 --> s2: you end the review and the save fails
    }
    --
    state "Note" as r1 {
      s3: No note yet
      s4: Save pending
      [*] --> s3
      s3 --> s4: you end the review and the save fails [when Review is Reviewing]
    }
    --
    state "Evidence" as r2 {
      s5: Evidence kept
      [*] --> s5
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 bugPath
  class s1 bugPath
  class s2 breaks
  class s2 bugPath
  class s3 bugPath
  class s4 breaks
  class s4 bugPath
  class s5 bugPath
